{
  "manifest_version": 3,
  "name": "AdLaurent",
  "author": "Djibr1l",
  "version": "1.1.0",
  "description": "Bloqueur de publicités par Djibr1l.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AdLaurent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adblock_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.cloud.microsoft/*",
        "*://cloud.microsoft/*",
        "*://*.teams.microsoft.com/*",
        "*://teams.microsoft.com/*",
        "*://*.teams.live.com/*",
        "*://teams.live.com/*",
        "*://*.microsoft.com/*",
        "*://microsoft.com/*",
        "*://*.microsoftonline.com/*",
        "*://microsoftonline.com/*",
        "*://*.office.com/*",
        "*://office.com/*",
        "*://*.office.net/*",
        "*://*.office365.com/*",
        "*://*.skype.com/*",
        "*://skype.com/*",
        "*://*.sharepoint.com/*",
        "*://*.live.com/*",
        "*://*.msftauth.net/*",
        "*://*.msauth.net/*",
        "*://*.azure.com/*",
        "*://*.azureedge.net/*",
        "*://*.windows.net/*",
        "*://*.trafficmanager.net/*",
        "*://*.msecnd.net/*",
        "*://*.gfx.ms/*",
        "*://*.lync.com/*",
        "*://*.skypeforbusiness.com/*"
      ],
      "js": ["inject_anti_adblock.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.cloud.microsoft/*",
        "*://cloud.microsoft/*",
        "*://*.teams.microsoft.com/*",
        "*://teams.microsoft.com/*",
        "*://*.teams.live.com/*",
        "*://teams.live.com/*",
        "*://*.microsoft.com/*",
        "*://microsoft.com/*",
        "*://*.microsoftonline.com/*",
        "*://microsoftonline.com/*",
        "*://*.office.com/*",
        "*://office.com/*",
        "*://*.office.net/*",
        "*://*.office365.com/*",
        "*://*.skype.com/*",
        "*://skype.com/*",
        "*://*.sharepoint.com/*",
        "*://*.live.com/*",
        "*://*.msftauth.net/*",
        "*://*.msauth.net/*",
        "*://*.azure.com/*",
        "*://*.azureedge.net/*",
        "*://*.windows.net/*",
        "*://*.trafficmanager.net/*",
        "*://*.msecnd.net/*",
        "*://*.gfx.ms/*",
        "*://*.lync.com/*",
        "*://*.skypeforbusiness.com/*"
      ],
      "js": ["content_generic.js"],
      "css": ["styles/generic_adblock.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["inject_youtube.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_youtube.js"],
      "css": ["styles/youtube.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["inject_twitch.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content_twitch.js"],
      "css": ["styles/twitch.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
